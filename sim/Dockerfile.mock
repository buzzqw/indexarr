FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/simmock ./cmd/simmock \
    && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/seed ./sim/seed

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -H -u 10001 sim \
    && mkdir -p /data \
    && chown sim:sim /data

USER sim
WORKDIR /data
COPY --from=build /out/simmock /usr/local/bin/simmock
COPY --from=build /out/seed /usr/local/bin/seed

EXPOSE 19080
ENTRYPOINT ["simmock", "-addr", ":19080"]
