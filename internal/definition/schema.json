{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indexarr.dev/schemas/definition-v1.json",
  "title": "indexarr definition",
  "description": "Native indexarr indexer definition, schema version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "meta"
  ],
  "properties": {
    "schema": {
      "const": 1,
      "description": "Definition format version."
    },
    "connector": {
      "type": "string",
      "description": "Optional native connector that interprets this definition, for example torznab or unit3d."
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "auth": {
      "$ref": "#/$defs/auth"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "search": {
      "$ref": "#/$defs/search"
    },
    "latest": {
      "$ref": "#/$defs/latest"
    },
    "download": {
      "$ref": "#/$defs/download"
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "protocol",
        "urls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable slug identifying the definition."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag, for example it-IT."
        },
        "type": {
          "enum": [
            "public",
            "semi-private",
            "private"
          ]
        },
        "protocol": {
          "enum": [
            "torrent",
            "usenet",
            "ed2k"
          ]
        },
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "description": "Primary URL first, then mirrors.",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "updated": {
          "type": "string",
          "description": "Free-form date of the last definition update."
        },
        "interval": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Optional suggested refresh interval as a Go duration, for example 15m. Empty means no recommendation; the global default applies."
        },
        "latest": {
          "type": "boolean",
          "default": true,
          "description": "Whether the site publishes a list or feed of new releases. Absent means true. A search-only site sets false: it has no scheduled run and is queried by the live search."
        },
        "derived_from": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Conversion tool that produced this draft, for example cardigann. Derived drafts are writing aids, stay local and are rejected by the built-in catalog."
        },
        "mirror": {
          "enum": [
            "official",
            "unofficial"
          ],
          "description": "Optional. \"unofficial\" marks a definition that currently works only through a non-official mirror; the UI shows a permanent badge and a warning even when the definition is verified."
        },
        "insecure_tls": {
          "type": "boolean",
          "description": "Optional, false by default. Valid only for a public definition: the site serves an incomplete TLS chain, so the engine skips certificate verification for this indexer only. The UI shows a permanent badge and a warning in the form."
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "type": "string",
          "description": "Form field type, for example text, password, checkbox or select."
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "standard"
      ],
      "properties": {
        "site": {
          "type": "string",
          "description": "Category id as used by the site."
        },
        "standard": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 8999
        },
        "desc": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": {
          "$ref": "#/$defs/params"
        },
        "tv-search": {
          "$ref": "#/$defs/params"
        },
        "movie-search": {
          "$ref": "#/$defs/params"
        },
        "music-search": {
          "$ref": "#/$defs/params"
        },
        "book-search": {
          "$ref": "#/$defs/params"
        }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "enum": [
          "q",
          "season",
          "ep",
          "imdbid",
          "tvdbid",
          "tmdbid",
          "tvmazeid",
          "rid",
          "artist",
          "album",
          "author",
          "title",
          "year",
          "genre"
        ]
      },
      "uniqueItems": true
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "api_key",
            "basic",
            "form",
            "cookie",
            "token"
          ],
          "default": "none"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authStep"
          }
        },
        "success": {
          "$ref": "#/$defs/condition"
        },
        "logged_in": {
          "$ref": "#/$defs/condition",
          "description": "Marker present on every authenticated page (for example the logout link). A details page without it means the site dropped the session: the engine logs in again once and reads the page again."
        },
        "failure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "refresh_after": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "",
            "flaresolverr"
          ],
          "default": "flaresolverr",
          "description": "Persistent browser session for every request of the indexer."
        },
        "endpoint": {
          "type": "string",
          "description": "FlareSolverr base URL or /v1 URL, or a template such as {{ settings.flaresolverr_url }}. Empty uses the global setting."
        },
        "name_prefix": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9-]*$",
          "description": "Ownership prefix for orphaned-session cleanup."
        },
        "max_age": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Recycle the browser session after this Go duration; default 12h."
        },
        "timeout": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Per-command FlareSolverr timeout; default 60s."
        }
      }
    },
    "authStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "get": {
          "type": "string"
        },
        "post": {
          "type": "string"
        },
        "form": {
          "$ref": "#/$defs/stringMap"
        },
        "headers": {
          "$ref": "#/$defs/stringMap"
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/extractor"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "get"
          ],
          "not": {
            "required": [
              "post"
            ]
          }
        },
        {
          "required": [
            "post"
          ],
          "not": {
            "required": [
              "get"
            ]
          }
        }
      ]
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "type": "string"
        },
        "attr": {
          "type": "string"
        },
        "json": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "contains": {
          "type": "string",
          "description": "Text the selected element must contain (case-insensitive) for the condition to match. Needs selector."
        }
      },
      "anyOf": [
        {
          "required": [
            "selector"
          ]
        },
        {
          "required": [
            "status"
          ]
        }
      ]
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preflight": {
          "$ref": "#/$defs/preflight"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        },
        "response": {
          "$ref": "#/$defs/response"
        },
        "keywords_format": {
          "enum": [
            "sxxeyy",
            "1x05",
            "separate"
          ],
          "default": "sxxeyy",
          "description": "How the TV episode marker is appended to query.keywords; separate leaves query.season and query.ep to the template."
        },
        "index": {
          "$ref": "#/$defs/searchIndex"
        },
        "blocked": {
          "$ref": "#/$defs/condition",
          "description": "Page the site answers instead of the results when it refuses the search (a flood control). The search fails with its message instead of reporting no results."
        },
        "cache": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "How long the result pages of the same search request are reused, for a site whose flood control allows one search every few minutes."
        },
        "interval": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Minimum time between two search requests sent to the site (a flood control counted per account). A search without a free slot in time is queued and sent in the background; the next identical request reads its page from the cache. Needs cache."
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "properties": {
        "get": {
          "type": "string"
        },
        "post": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "form": {
          "$ref": "#/$defs/params"
        },
        "headers": {
          "$ref": "#/$defs/params"
        },
        "extract": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/extractor"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "get"
          ]
        },
        {
          "required": [
            "post"
          ]
        }
      ]
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categories": {
          "type": "array",
          "description": "Standard-to-site category mappings used by the request template as {{ category }}. Empty means one global list.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "standard",
              "site"
            ],
            "properties": {
              "standard": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 8999
              },
              "site": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        },
        "response": {
          "$ref": "#/$defs/response"
        },
        "stop_when_known": {
          "type": "boolean",
          "default": true,
          "description": "Stop after a page made entirely of cached rows; set false for cheap lists that need a full backfill."
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extract"
      ],
      "properties": {
        "resolve_on": {
          "enum": [
            "search",
            "grab"
          ],
          "default": "grab",
          "description": "search opens details pages while searching; grab (the default) waits until Download."
        },
        "from": {
          "type": "string",
          "default": "details",
          "description": "Search field that holds the details URL; empty means details."
        },
        "max_concurrent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "default": 2,
          "description": "Maximum details requests in flight; 0 uses the default of 2."
        },
        "select": {
          "enum": [
            "",
            "season_episode"
          ],
          "description": "Choose among multiple targets by the season and episode of the grab request."
        },
        "before": {
          "$ref": "#/$defs/downloadBefore"
        },
        "extract": {
          "type": "array",
          "minItems": 1,
          "description": "Extractors tried in order; the first match wins.",
          "items": {
            "$ref": "#/$defs/downloadTarget"
          }
        },
        "title": {
          "$ref": "#/$defs/field",
          "description": "Optional full title extracted from the details page."
        },
        "size": {
          "$ref": "#/$defs/field",
          "description": "Optional file size extracted from the details page."
        },
        "expand": {
          "type": "string",
          "enum": [
            "",
            "file"
          ],
          "description": "With resolve_on: search, create one release per extracted eD2k file (a season pack becomes its episodes)."
        }
      }
    },
    "downloadBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "wait": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Pause before reopening the topic."
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/extractor"
          },
          "description": "Values read from the topic page before the action."
        },
        "action": {
          "$ref": "#/$defs/request"
        }
      }
    },
    "downloadTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "magnet": {
          "$ref": "#/$defs/field"
        },
        "torrent": {
          "$ref": "#/$defs/field"
        },
        "all": {
          "type": "boolean",
          "description": "Collect every match of this target instead of only the first."
        },
        "ed2k": {
          "$ref": "#/$defs/field"
        }
      },
      "oneOf": [
        {
          "required": [
            "magnet"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "torrent"
                ]
              },
              {
                "required": [
                  "ed2k"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "torrent"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "magnet"
                ]
              },
              {
                "required": [
                  "ed2k"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "ed2k"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "magnet"
                ]
              },
              {
                "required": [
                  "torrent"
                ]
              }
            ]
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "get": {
          "type": "string"
        },
        "post": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/stringMap"
        },
        "params_multi": {
          "$ref": "#/$defs/stringListMap"
        },
        "form": {
          "$ref": "#/$defs/stringMap"
        },
        "headers": {
          "$ref": "#/$defs/stringMap"
        }
      },
      "anyOf": [
        {
          "required": [
            "get"
          ],
          "not": {
            "required": [
              "post"
            ]
          }
        },
        {
          "required": [
            "post"
          ],
          "not": {
            "required": [
              "get"
            ]
          }
        }
      ]
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "none",
            "page",
            "offset",
            "cursor"
          ],
          "default": "none"
        },
        "start": {
          "type": "integer"
        },
        "step": {
          "type": "integer"
        },
        "max_pages": {
          "type": "integer",
          "minimum": 0
        },
        "param": {
          "type": "string"
        },
        "stop_when": {
          "type": "string",
          "description": "For example empty_rows."
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "html",
            "json",
            "xml"
          ]
        },
        "rows": {
          "$ref": "#/$defs/rows"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "rows": {
      "oneOf": [
        {
          "$ref": "#/$defs/selector"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "path": {
              "type": "string",
              "description": "Dotted or JSON pointer path to the result rows."
            }
          }
        }
      ]
    },
    "selector": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "attr": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "int",
            "size",
            "date",
            "url",
            "category"
          ],
          "default": "text"
        },
        "path": {
          "type": "string",
          "description": "Dotted path for JSON responses."
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "layouts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Go time layouts for date fields."
        },
        "body": {
          "type": "boolean",
          "description": "Read the whole details response and scan the text (for pages that build links in JavaScript)."
        },
        "self": {
          "type": "boolean",
          "description": "Read the row node itself (an index page is a list of anchors)."
        }
      }
    },
    "filter": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      ]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        },
        "min_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "fixture": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "description": "Fixture path relative to the definition, without '..'."
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_rows": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authenticated": {
          "type": "boolean"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stringListMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "searchIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "response"
      ],
      "properties": {
        "max_topics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Topics opened for one query; 0 uses 5."
        },
        "response": {
          "$ref": "#/$defs/response"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexPage"
          }
        },
        "forum": {
          "type": "string",
          "description": "Optional forum URL that holds the letter topics of the index; shown in the form."
        }
      }
    },
    "indexPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "get"
      ],
      "properties": {
        "get": {
          "type": "string"
        },
        "letter": {
          "type": "string",
          "pattern": "^$|^[A-Za-z#]$",
          "description": "Empty for a page that covers every title, otherwise the letter it lists."
        },
        "standard": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 8999
        }
      }
    }
  }
}
